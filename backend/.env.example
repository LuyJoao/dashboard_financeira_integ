# Usuário, senha e banco criados no PostgreSQL (veja o README)
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/pagamentos
# gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-esta-chave
ACCESS_TOKEN_MINUTES=60
RESET_TOKEN_MINUTES=30
# "null" é a origem do Electron em produção (file://)
CORS_ORIGINS=["http://localhost:5173","null"]
