# Usuário, senha e banco criados no PostgreSQL (veja o README)
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/pagamentos
# gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=8hYf9PNjjwSJ5S8B4XuhM_dHPVP7QZi_SlZvFzIPmnMyZ_KWwM_c-cExDzP2s0dV
ACCESS_TOKEN_MINUTES=60
RESET_TOKEN_MINUTES=30
# "null" é a origem do Electron em produção (file://)
CORS_ORIGINS=["http://localhost:5173","null"]

# E-mail do "esqueci a senha". Com SMTP_HOST vazio o código só aparece no console da API (desenvolvimento).
# Depois de preencher, teste com: python -m app.testar_email seu@email.com
SMTP_HOST=
SMTP_PORT=587
# starttls (porta 587), ssl (porta 465) ou nenhuma
SMTP_SEGURANCA=starttls
SMTP_USUARIO=
SMTP_SENHA=
# Quem aparece como remetente, ex.: INTEG <naoresponda@integ.org.br> (vazio = usa SMTP_USUARIO)
SMTP_REMETENTE=
# Desligue (false) só se o servidor interno tiver certificado próprio, não reconhecido
SMTP_VALIDAR_CERTIFICADO=true
# Intervalo mínimo, em segundos, entre dois pedidos de código para o mesmo e-mail
RESET_INTERVALO_SEGUNDOS=60
